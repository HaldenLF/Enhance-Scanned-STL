<!DOCTYPE FilterScript>
<FilterScript>
 <!-- STEP 1: Repair -->
 <filter name="Remove Duplicate Faces"/>
 <filter name="Remove Duplicate Vertices"/>
 <filter name="Remove Zero Area Faces"/>
 <filter name="Remove Unreferenced Vertices"/>
 <filter name="Repair non Manifold Edges">
  <Param tooltip="Selects whether to remove non manifold edges by removing faces or by splitting vertices." type="RichEnum" value="0" enum_val0="Remove Faces" enum_val1="Split Vertices" description="Method" enum_cardinality="2" name="method"/>
 </filter>
 <filter name="Repair non Manifold Vertices by splitting">
  <Param tooltip="Vertex Displacement Ratio" type="RichFloat" value="0" description="Vertex Displacement Ratio" name="VertDispRatio"/>
 </filter>
 <filter name="Repair non Manifold Edges">
  <Param tooltip="Selects whether to remove non manifold edges by removing faces or by splitting vertices." type="RichEnum" value="0" enum_val0="Remove Faces" enum_val1="Split Vertices" description="Method" enum_cardinality="2" name="method"/>
 </filter>
 <filter name="Close Holes">
  <Param tooltip="Max size (edges) of holes to close." type="RichInt" value="100" description="Max size to be closed" name="MaxHoleSize"/>
  <Param tooltip="Close holes with selected faces" type="RichBool" value="false" description="Close holes with selected faces" name="Selected"/>
  <Param tooltip="Select the newly created faces" type="RichBool" value="false" description="Select the newly created faces" name="NewFaceSelected"/>
  <Param tooltip="Prevent creation of selfIntersecting faces" type="RichBool" value="true" description="Prevent creation of selfIntersecting faces" name="SelfIntersection"/>
  <Param tooltip="Refine Filled Hole" type="RichBool" value="true" description="Refine Filled Hole" name="RefineHole"/>
 </filter>

  <!-- STEP 2: Sharpen -->
  <filter name="Taubin Smooth">
  <Param tooltip="Lambda" type="RichFloat" value="0.5" description="Lambda" name="lambda"/>
  <Param tooltip="mu" type="RichFloat" value="-0.53" description="mu" name="mu"/>
  <Param tooltip="Smoothing steps" type="RichInt" value="70" description="Smoothing steps" name="stepSmoothNum"/>
  <Param tooltip="Affect only selected faces" type="RichBool" value="false" description="Affect only selected faces" name="Selected"/>
 </filter>
 <filter name="UnSharp Mask Geometry">
  <Param tooltip="Unsharp Weight" type="RichFloat" value="0.3" description="Unsharp Weight" name="weight"/>
  <Param tooltip="Original Weight" type="RichFloat" value="1" description="Original Weight" name="weightOrig"/>
  <Param tooltip="Smooth Iterations" type="RichInt" value="25" description="Smooth Iterations" name="iterations"/>
 </filter>

 <!-- STEP 3: Reduce vertex count by 50%  -->
 <filter name="Simplification: Quadric Edge Collapse Decimation">
  <Param tooltip="Target number of faces" type="RichInt" value="0" description="Target number of faces" name="TargetFaceNum"/>
  <Param tooltip="Percentage reduction (0..1)" type="RichFloat" value="0.5" description="Percentage reduction (0..1)" name="TargetPerc"/>
  <Param tooltip="Quality threshold" type="RichFloat" value="0.3" description="Quality threshold" name="QualityThr"/>
  <Param tooltip="Preserve Boundary of the mesh" type="RichBool" value="true" description="Preserve Boundary of the mesh" name="PreserveBoundary"/>
  <Param tooltip="Boundary Preserving Weight" type="RichFloat" value="1" description="Boundary Preserving Weight" name="BoundaryWeight"/>
  <Param tooltip="Preserve Normal" type="RichBool" value="true" description="Preserve Normal" name="PreserveNormal"/>
  <Param tooltip="Preserve Topology" type="RichBool" value="true" description="Preserve Topology" name="PreserveTopology"/>
  <Param tooltip="Optimal position of simplified vertices" type="RichBool" value="true" description="Optimal position of simplified vertices" name="OptimalPlacement"/>
  <Param tooltip="Planar Simplification" type="RichBool" value="true" description="Planar Simplification" name="PlanarQuadric"/>
  <Param tooltip="Weighted Simplification" type="RichBool" value="false" description="Weighted Simplification" name="QualityWeight"/>
  <Param tooltip="Post-simplification cleaning" type="RichBool" value="true" description="Post-simplification cleaning" name="AutoClean"/>
  <Param tooltip="Simplify only selected faces" type="RichBool" value="false" description="Simplify only selected faces" name="Selected"/>
 </filter>

 <!-- STEP 4: Repair again -->
 <filter name="Remove Duplicate Faces"/>
 <filter name="Remove Duplicate Vertices"/>
 <filter name="Remove Zero Area Faces"/>
 <filter name="Remove Unreferenced Vertices"/>
 <filter name="Repair non Manifold Edges">
  <Param tooltip="Selects whether to remove non manifold edges by removing faces or by splitting vertices." type="RichEnum" value="0" enum_val0="Remove Faces" enum_val1="Split Vertices" description="Method" enum_cardinality="2" name="method"/>
 </filter>
 <filter name="Repair non Manifold Vertices by splitting">
  <Param tooltip="Vertex Displacement Ratio" type="RichFloat" value="0" description="Vertex Displacement Ratio" name="VertDispRatio"/>
 </filter>
 <filter name="Repair non Manifold Edges">
  <Param tooltip="Selects whether to remove non manifold edges by removing faces or by splitting vertices." type="RichEnum" value="0" enum_val0="Remove Faces" enum_val1="Split Vertices" description="Method" enum_cardinality="2" name="method"/>
 </filter>
 <filter name="Close Holes">
  <Param tooltip="Max size (edges) of holes to close." type="RichInt" value="100" description="Max size to be closed" name="MaxHoleSize"/>
  <Param tooltip="Close holes with selected faces" type="RichBool" value="false" description="Close holes with selected faces" name="Selected"/>
  <Param tooltip="Select the newly created faces" type="RichBool" value="false" description="Select the newly created faces" name="NewFaceSelected"/>
  <Param tooltip="Prevent creation of selfIntersecting faces" type="RichBool" value="true" description="Prevent creation of selfIntersecting faces" name="SelfIntersection"/>
  <Param tooltip="Refine Filled Hole" type="RichBool" value="true" description="Refine Filled Hole" name="RefineHole"/>
 </filter>


 <filter name="Compute Geometric Measures"/>
</FilterScript>
